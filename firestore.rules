rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only these two accounts count as admins. To add or remove an admin, edit this
    // list, publish the rules, and add/delete the user under Authentication > Users.
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['a.khan120701@gmail.com', 'fatwa@duny.us'];
    }

    // Everything below is publicly readable; only an admin may create/update/delete.
    match /fatwas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /magazine/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
