rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only these two accounts count as admins. To add or remove an admin, edit this
    // list, publish the rules, and add/delete the user under Authentication > Users.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['a.khan120701@gmail.com', 'fatwa@duny.us'];
    }

    // Fatwas are publicly readable (the Iftaa page loads them for every visitor),
    // but only an admin may create/update/delete them.
    match /fatwas/{fatwaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Research papers, monthly magazine issues and events: publicly readable,
    // writable only by an admin.
    match /{coll}/{docId} {
      allow read: if coll in ['articles', 'magazine', 'events'];
      allow write: if isAdmin() && coll in ['articles', 'magazine', 'events'];
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
