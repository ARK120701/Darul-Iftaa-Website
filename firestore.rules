rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fatwas are publicly readable (the Iftaa page loads them for every visitor),
    // but only a signed-in admin (Firebase Auth) may create/update/delete them.
    match /fatwas/{fatwaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Research papers, monthly magazine issues and events: publicly readable,
    // writable only by the signed-in admin.
    match /{coll}/{docId} {
      allow read: if coll in ['articles', 'magazine', 'events'];
      allow write: if request.auth != null && coll in ['articles', 'magazine', 'events'];
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
