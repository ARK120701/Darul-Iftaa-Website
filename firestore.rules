rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fatwas are publicly readable (the Iftaa page loads them for every visitor),
    // but only a signed-in admin (Firebase Auth) may create/update/delete them.
    match /fatwas/{fatwaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
